    },
    "./git": {
      "types": "./dist/src/infrastructure/git/index.d.ts",
      "import": "./dist/src/infrastructure/git/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "lint": "node scripts/lint.mjs",
    "test": "node --test dist/tests/*.js",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run import-boundary",
    "import-boundary": "node scripts/check-import-boundary.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.2"
  }
}

