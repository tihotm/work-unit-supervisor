    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./core": {
      "types": "./dist/src/core/index.d.ts",
      "import": "./dist/src/core/index.js"
    },
    "./ports": {
      "types": "./dist/src/ports/index.d.ts",
      "import": "./dist/src/ports/index.js"
    },
    "./policies": {
      "types": "./dist/src/policies/index.d.ts",
      "import": "./dist/src/policies/index.js"
    },
    "./executors": {
      "types": "./dist/src/executors/index.d.ts",
      "import": "./dist/src/executors/index.js"
    },
    "./project-adapter": {
      "types": "./dist/src/project-adapter/index.d.ts",
      "import": "./dist/src/project-adapter/index.js"
    },
    "./project-supervisor": {
      "types": "./dist/src/project-supervisor/index.d.ts",
      "import": "./dist/src/project-supervisor/index.js"
    },
    "./project-execution-entrypoint": {
      "types": "./dist/src/project-execution-entrypoint/index.d.ts",
      "import": "./dist/src/project-execution-entrypoint/index.js"
    },
    "./diff-auditor": {
      "types": "./dist/src/diff-auditor/index.d.ts",
      "import": "./dist/src/diff-auditor/index.js"
    },
    "./workflow": {
      "types": "./dist/src/workflow/index.d.ts",
