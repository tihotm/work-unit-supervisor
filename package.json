{
  "name": "work-unit-supervisor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "lint": "node scripts/lint.mjs",
    "test": "node --test dist/tests/smoke.test.js",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run import-boundary",
    "import-boundary": "node scripts/check-import-boundary.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.2"
  }
}
